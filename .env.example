# ---------------------------------------------------------------------------
# EnvoraSports — environment template. Copy to .env and fill in.
# .env is git-ignored. Never commit real credentials (§50).
# ---------------------------------------------------------------------------

# PostgreSQL. Special characters in the password MUST be percent-encoded.
#   [ -> %5B   ] -> %5D   : -> %3A   @ -> %40   & -> %26   * -> %2A   / -> %2F
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=prefer"

# Football data provider. Set to "mock" to run the whole pipeline offline.
FOOTBALL_PROVIDER="api-football"
FOOTBALL_API_KEY=""
FOOTBALL_API_BASE_URL="https://v3.football.api-sports.io"

# Odds / bulletin provider. Tells us which markets are actually priced.
ODDS_PROVIDER="the-odds-api"
ODDS_API_KEY=""
ODDS_API_BASE_URL="https://api.the-odds-api.com/v4"

# Provider quotas. The guard refuses any call that would exceed them.
# API-Football Free: 100 requests / day.
FOOTBALL_API_DAILY_BUDGET="100"
# The Odds API Free: 500 credits / month (a request costs markets x regions).
ODDS_API_MONTHLY_BUDGET="500"

# Narration: turns a prediction's computed feature breakdown into readable
# EN/TR prose. It never invents numbers or reasons (§48) - set to "none"
# to fall back to deterministic template sentences.
NARRATION_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Billing (provider-agnostic; Stripe is the reference implementation).
BILLING_PROVIDER="none"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:6247"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
AUTH_SECRET=""

# Protects cron/job endpoints from public invocation.
JOB_TRIGGER_SECRET=""
